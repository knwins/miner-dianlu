# BSC 测试网部署所需（复制为 .env 并填写；.env 已在 .gitignore，不会提交）
# 部署者私钥（0x 开头，64 位十六进制）。只用测试网钱包，勿用主网密钥！
DEPLOYER_PRIVATE_KEY=

# BSC 测试网 RPC（Binance 官方 seed 在部分网络不可达，publicnode 已验证可用）
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# BEM 代币地址（BSC **主网** chainId 56，已给定；该地址在测试网无代码）
BEM_TOKEN=0x5ce033b2bfca3af30b3e8c8457deaf776a8b695a
# 说明：真实 BEM 只在 BSC 主网。测试网部署时脚本会检测到无代码，自动改布一个 MockBEM 供调试；
#       上主网时才用上面这个真实地址。

# 可选：真实 PoD 挖矿合约地址；留空则部署 Mock 供调试
POD_ADDRESS=
MINTER_ADDRESS=

# 可选：BscScan API Key。填写后，开源验证会同时提交到 BscScan；留空则只提交 Sourcify。
BSCSCAN_API_KEY=

SHARE_PRICE_BNB=0.01
TOTAL_SHARES=100
FEE_PERCENT=5
FUNDING_DAYS=7
TASK_ID=54
