# 部署环境变量示例：复制为 contracts/.env 后填写（.env 已在 .gitignore，不会提交）
# 部署者私钥（0x 开头，64 位十六进制）。主网部署请用专用部署钱包，余额够付 gas 即可。
DEPLOYER_PRIVATE_KEY=

# BSC 主网 / 测试网 RPC（publicnode 已验证可用）
BSC_RPC=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# 电路市场地址。留空 = 官方主网市场 0x6feEbbEbC07BcB90bd1Ac8b0CF9BaA4f0fF2B46f。
# ⚠ 不再兼容旧的 MINTER_ADDRESS：那指向晶体管时代的旧市场，留着会把工厂接错市场。
CIRCUIT_MARKET_ADDRESS=

# 工厂白名单：逗号分隔的 ERC721 电路合约地址。
# 留空 = 官方两件套 TapeOut / Behemoth。脚本会逐个校验 supportsInterface(0x80ac58cd)。
ALLOWED_CIRCUITS_ADDRESSES=

# 官方 PoD 挖矿 / BEM（主网可留空用默认；测试网若不填会部署 Mock）。
# POD_MINING_ADDRESS=0x7E2E0DC66a3bD9103E69b766afA62d9f7b697b46
# BEM_ADDRESS=0x5ce033B2bFCa3Af30b3e8C8457DeaF776A8b695a
POD_MINING_ADDRESS=
BEM_ADDRESS=

# 可选：BscScan API Key。填写后开源验证会同时提交到 BscScan；留空则只提交 Sourcify。
BSCSCAN_API_KEY=

# 可选：DRY_RUN=1 只打印参数与费用，不发交易
DRY_RUN=
